# MODELO (desenho P1a): o runner gera o nginx.conf efetivo por ambiente trocando @@INTERNA@@; o nginx.conf ao lado
# continua o dos ambientes ja criados.
# Gateway da HOMOLOGACAO: unico servico publicado. Origem unica HTTPS (certificado da CA da homologacao; nome em
# HOMOLOG_HOST), primeira camada de limite (limit_req por IP/rota), X-Forwarded-For SOBRESCRITO com o IP da conexao.
# Log de acesso so com metodo, caminho sem query ($uri), status e tempo: nunca cookie, cabecalho ou corpo.
# Mesmo desenho do gateway de referencia do E2E (api/e2e/nginx.conf).
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    client_max_body_size 8k;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    log_format nekkora '$remote_addr "$request_method $uri" $status $body_bytes_sent $request_time';
    access_log /dev/stdout nekkora;

    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=geral:10m rate=30r/s;
    limit_req_status 429;
    limit_req_log_level warn;

    upstream platform {
        server @@INTERNA@@.20:8081;
    }

    upstream portal {
        server @@INTERNA@@.21:8082;
    }

    server {
        listen 443 ssl;
        server_name _;
        ssl_certificate /tls/gateway.crt;
        ssl_certificate_key /tls/gateway.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        location /portal/api/v1/ {
            limit_req zone=geral burst=20 nodelay;
            proxy_pass http://portal;
        }

        location ~ ^/api/v1/o/[^/]+/auth/ {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass http://platform;
        }

        location /api/v1/ {
            limit_req zone=geral burst=20 nodelay;
            proxy_pass http://platform;
        }

        location / {
            return 404;
        }
    }
}
