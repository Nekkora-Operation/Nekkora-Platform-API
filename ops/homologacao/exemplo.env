# Variaveis da homologacao - EXEMPLO SEM VALORES. Os valores reais sao gerados por "homologacao.sh criar" em
# HOMOLOG_SEGREDOS (fora do Git) e nunca sao versionados. Os nomes em portugues continuam os da entrega (decisao do
# responsavel); as variaveis SPRING_* sao as da propria Spring, sem valor padrao.

# --- operador (opcionais) ---
HOMOLOG_HOST=               # nome da origem publica (certificado do gateway); padrao homologacao.nekkora.test
HOMOLOG_PORTA=              # porta publicada do gateway; padrao 55643
HOMOLOG_BIND=               # interface publicada; padrao 127.0.0.1 (para a equipe: a interface da rede interna)
HOMOLOG_SEGREDOS=           # diretorio dos segredos; padrao $HOME/.nekkora/homologacao/<id>
HOMOLOG_ATE=                # ultima migration: 015 (padrao; desenho anterior) ou 016 (so id ensaio-*, com a linha de P3)
HOMOLOG_REDE_INTERNA=       # prefixo /24 da rede interna; padrao 10.252.10 (com a hml03 ainda existente: ex. 10.252.20)
HOMOLOG_REDE_BORDA=         # prefixo /24 da rede de borda; padrao 10.252.11 (ex. 10.252.21)
HOMOLOG_TRANSPORTE=         # vazio ou homologacao (transporte de e-mail de homologacao; so ensaio-* com a 016)

# --- platform.env (processo Platform) ---
NEKKORA_DB_URL=             # jdbc:postgresql://postgres:5432/nekkora?sslmode=verify-full&sslrootcert=/tls/ca.crt
NEKKORA_DB_SENHA=
NEKKORA_ORIGEM_PUBLICA=     # https://<HOMOLOG_HOST>:<HOMOLOG_PORTA>
NEKKORA_PROXIES_CONFIAVEIS= # <HOMOLOG_REDE_INTERNA>.5/32 (o gateway)
NEKKORA_MFA_CHAVE_ID=
NEKKORA_MFA_CHAVES=         # k1:<base64 de 32 bytes>
NEKKORA_HMAC_ID=
NEKKORA_HMAC_CHAVE=         # base64 de 32 bytes
NEKKORA_REDIS_HOST=         # redis
NEKKORA_REDIS_PORT=         # 6379 (so TLS)
SPRING_DATA_REDIS_USERNAME= # platform
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_BUNDLE=                         # redis
SPRING_SSL_BUNDLE_PEM_REDIS_TRUSTSTORE_CERTIFICATE=   # file:/tls/ca.crt

# --- portal.env (processo Portal; nenhuma variavel da Platform) ---
NEKKORA_PORTAL_DB_URL=
NEKKORA_PORTAL_DB_SENHA=
NEKKORA_PROXIES_CONFIAVEIS=
NEKKORA_REDIS_HOST=
NEKKORA_REDIS_PORT=
SPRING_DATA_REDIS_USERNAME= # portal
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_BUNDLE=
SPRING_SSL_BUNDLE_PEM_REDIS_TRUSTSTORE_CERTIFICATE=

# --- so com HOMOLOG_TRANSPORTE=homologacao (compose.caixa.yml; nao ficam no platform.env) ---
# NEKKORA_AMBIENTE=<id ensaio-*>  NEKKORA_MAIL_TRANSPORTE=homologacao  NEKKORA_MAIL_CAIXA=/caixa  NEKKORA_AVISOS_EMERGENCIA=true

# --- operacao.env (job de operacao da 016; so ensaio-*) ---
NEKKORA_AMBIENTE=
NEKKORA_OPS_DB_URL=         # jdbc:postgresql://postgres:5432/nekkora
NEKKORA_OPS_RAIZ_SERVIDOR=  # /tls/ca.crt
HOMOLOG_OPS_CA_CRT=         # /tls/ops-ca.crt (CA OPERACIONAL descartavel)
HOMOLOG_OPS_CA_KEY=         # /tls/ops-ca.key (so este job a monta)
HOMOLOG_OPS_CA_SENHA=       # senha de nekkora_ops_ca
HOMOLOG_OPS_INTAKE_SENHA=   # senha de nekkora_ops_intake
HOMOLOG_OPERADORES=         # /operadores (volume exclusivo)
NEKKORA_OPS_LOG=            # /operadores/cli.log

# --- flyway.conf (identidade de implantacao) ---
# flyway.url=  flyway.user=migrador_nekkora  flyway.password=
