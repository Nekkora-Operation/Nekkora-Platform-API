# MODELO do pg_hba da HOMOLOGACAO com a 016 (desenho P1a, §3.3). O runner gera o arquivo efetivo por ambiente,
# trocando @@INTERNA@@ pelo prefixo /24 da rede interna (HOMOLOG_REDE_INTERNA). O pg_hba.conf ao lado continua o dos
# ambientes ja criados (ex.: hml03) e nao muda.
# pg_hba da HOMOLOGACAO (ops/homologacao). Sem trust. Sem conexao em texto claro pela rede. Cada identidade so a partir
# do IP fixo do proprio container na rede interna (@@INTERNA@@.0/24, compose.homolog.yml), com SCRAM e TLS; qualquer outra
# origem, usuario ou banco e recusada explicitamente no fim. A ordem importa: a primeira linha que casa decide.
#
# TYPE    DATABASE   USER                ADDRESS             METHOD
# administrador do cluster: so pelo socket local do proprio container (bootstrap, elevacao temporaria, operacao)
local     all        admin_cluster                           scram-sha-256
local     all        all                                     reject
# identidade de implantacao (Flyway), so do container de implantacao
hostssl   nekkora    migrador_nekkora    @@INTERNA@@.30/32     scram-sha-256
# servicos: cada um so do proprio container
hostssl   nekkora    nekkora_platform    @@INTERNA@@.20/32     scram-sha-256
hostssl   nekkora    nekkora_portal      @@INTERNA@@.21/32     scram-sha-256
# backup logico (somente leitura, BYPASSRLS), so do container de backup
hostssl   nekkora    backup_nekkora      @@INTERNA@@.32/32     scram-sha-256
# ferramentas de verificacao (H03/H04), administrador pela rede SO deste container efemero e SO com TLS
hostssl   all        admin_cluster       @@INTERNA@@.31/32     scram-sha-256
# recuperacao emergencial de MFA (016), so do job de operacao (@@INTERNA@@.33):
#  - operadores op_*: SO certificado de cliente da CA operacional do ambiente (ssl_ca_file), CN = papel pelo
#    pg_ident "ops"; nao ha regra de senha para op_* (senha cai no reject final)
#  - servico da CA e servico de entrada (simulados no mesmo job): SCRAM, cada um com a sua senha. LIMITE DECLARADO da
#    homologacao: nao ha isolamento por ENDERECO entre eles (em producao, cada servico tera o seu)
hostssl   nekkora    /^op_               @@INTERNA@@.33/32     cert map=ops clientname=CN
hostssl   nekkora    nekkora_ops_ca      @@INTERNA@@.33/32     scram-sha-256
hostssl   nekkora    nekkora_ops_intake  @@INTERNA@@.33/32     scram-sha-256
# todo o resto: recusado (inclusive texto claro)
host      all        all                 0.0.0.0/0           reject
host      all        all                 ::/0                reject
