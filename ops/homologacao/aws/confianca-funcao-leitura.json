{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoAOperadoraComMfa",
      "Effect": "Allow",
      "Principal": { "AWS": "${ARN_OPERADORA}" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "NumericLessThan": { "aws:MultiFactorAuthAge": "3600" }
      }
    }
  ]
}
