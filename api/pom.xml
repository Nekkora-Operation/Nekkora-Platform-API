<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nekkora Platform - API v1 (Java 21, Spring Boot 4.1.1, Spring MVC bloqueante, JDBC/pgJDBC).
  Modulos:
    nekkora-core     - biblioteca comum: transacao com contexto RLS (set_config por bind), reset explicito
                       da conexao (DISCARD ALL) na devolucao ao pool, tokens D2, IP do proxy confiavel,
                       limitador Redis, erros genericos, log sanitizado.
    nekkora-platform - processo da Platform (papel nekkora_platform): autenticacao, MFA, sessoes, rotas internas.
    nekkora-portal   - processo do portal externo (papel nekkora_portal): so as 4 funcoes publicas da 013.
    nekkora-ops      - recuperacao emergencial de MFA (016): verificador do IdP, emissor da CA operacional e CLI do
                       operador (papel op_* por certificado). CANDIDATO, sem habilitacao em producao.
  Versoes: gerenciadas pelo spring-boot-starter-parent 4.1.1 (Spring Framework 7.0.9, Spring Security 7.1.1,
  Tomcat 11.0.24, pgJDBC 42.7.13, HikariCP 7.0.2, Lettuce 7.5.2, Testcontainers 2.0.5), mais Bouncy Castle 1.86.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.nekkora</groupId>
    <artifactId>nekkora-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>nekkora-core</module>
        <module>nekkora-ops</module>
        <module>nekkora-platform</module>
        <module>nekkora-portal</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.nekkora</groupId>
                <artifactId>nekkora-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nekkora</groupId>
                <artifactId>nekkora-ops</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- testes de integracao usam PostgreSQL 16 e Redis reais (Testcontainers) -->
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
